---
export interface LogoItem {
  src: string;
  alt: string;
}

interface Props {
  logos: LogoItem[];
}

const { logos } = Astro.props as Props;

/** Repeat logos so one strip is always wider than a large desktop viewport. */
const minItemsPerStrip = 12;
const repeats = Math.max(1, Math.ceil(minItemsPerStrip / Math.max(logos.length, 1)));
const stripLogos = Array.from({ length: repeats }, () => logos).flat();
---

<!-- Static grid on small viewports; scrolling marquee from md breakpoint up -->
<ul
  class="logo-marquee-gallery m-0 list-none grid grid-cols-2 gap-5 p-8 sm:grid-cols-3 sm:gap-8 sm:p-10 md:hidden"
  aria-label="Partner logos"
>
  {logos.map((logo) => (
    <li class="flex aspect-[5/4] items-center justify-center rounded-lg border border-gray-100 bg-white/80 p-5 sm:p-6">
      <img
        src={logo.src}
        alt={logo.alt}
        class="h-full w-full max-h-full max-w-full object-contain object-center"
        loading="lazy"
        decoding="async"
      />
    </li>
  ))}
</ul>

<div class="logo-marquee hidden md:block" aria-label="Partner logos marquee">
  <div class="logo-marquee-track">
    <ul class="logo-marquee-group">
      {stripLogos.map((logo) => (
        <li class="logo-marquee-item">
          <img src={logo.src} alt={logo.alt} loading="eager" decoding="async" />
        </li>
      ))}
    </ul>
    <ul class="logo-marquee-group" aria-hidden="true">
      {stripLogos.map((logo) => (
        <li class="logo-marquee-item">
          <img src={logo.src} alt="" loading="eager" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .logo-marquee {
    overflow: hidden;
    width: 100%;
  }

  .logo-marquee-track {
    display: flex;
    width: max-content;
    animation: logo-marquee-scroll 55s linear infinite;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  .logo-marquee:hover .logo-marquee-track {
    animation-play-state: paused;
  }

  .logo-marquee-group {
    display: flex;
    flex: 0 0 auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logo-marquee-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 17rem;
    padding: 2.5rem 2rem;
  }

  .logo-marquee-item img {
    max-height: 120px;
    max-width: 100%;
    width: auto;
    object-fit: contain;
    transform: translateZ(0);
  }

  @media (min-width: 1280px) {
    .logo-marquee-item {
      width: 19rem;
      padding: 2.75rem 2.25rem;
    }

    .logo-marquee-item img {
      max-height: 136px;
    }
  }

  /* Move exactly one group width (-50% of the duplicated track). */
  @keyframes logo-marquee-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee-track {
      animation: none;
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    .logo-marquee-group[aria-hidden="true"] {
      display: none;
    }

    .logo-marquee-group {
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
    }
  }
</style>
