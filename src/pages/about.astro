---
import ReynoldsLayout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<ReynoldsLayout
  title="About Reynolds Dryline | Leicestershire Since 1963"
  description="Learn about Reynolds Dryline, Leicestershire drylining specialists since 1963. Expertise in partitioning, ceilings and building finishes UK-wide."
  canonical="https://www.reynoldsdryline.co.uk/about"
>

  <PageHero
    title="About Reynolds Dryline"
    subtitle="Over 60 years of excellence in specialist building finishes. Our story is built on expertise, integrity, and a relentless commitment to quality."
    breadcrumb="Our Story"
  />

  <!-- Our Story -->
  <section class="rd-section rd-section--surface px-6 lg:px-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div data-animate>
        <p class="rd-label mb-3">Our Heritage</p>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-6 leading-tight">
          Building Excellence Since 1963
        </h2>
        <div class="space-y-4 text-gray-600 leading-relaxed">
          <p>
            Reynolds Dryline was founded in 1963 with a simple but powerful vision: to provide the highest quality building finishes with unmatched reliability and expertise. Over six decades later, that vision remains at the heart of everything we do.
          </p>
          <p>
            From our base in Leicestershire, we have grown to become one of the most trusted specialist subcontractors in the UK, delivering complete dryline solutions for some of the country's most prestigious construction projects.
          </p>
          <p>
            Our reputation has been built not on being the biggest, but on being the most dependable. When contractors need a partner they can rely on to deliver to programme, within budget, and to the highest quality standards — they call Reynolds Dryline.
          </p>
        </div>
      </div>

      <div class="relative" data-animate data-delay="100">
        <div class="rounded-2xl overflow-hidden shadow-xl ring-1 ring-black/5">
          <img
            src="/assets/reynolds/project-bletchley.jpg"
            alt="Reynolds Dryline project - Bletchley View"
            class="w-full h-96 object-cover"
            loading="lazy"
          />
        </div>
        <!-- Year badge -->
        <div class="absolute -bottom-6 -left-2 sm:-left-4 bg-red-600 text-white p-5 sm:p-6 text-center rounded-2xl shadow-lg max-[480px]:left-2">
          <span class="text-4xl sm:text-5xl font-black block">60+</span>
          <span class="text-xs sm:text-sm font-bold tracking-widest uppercase">Years of Excellence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="rd-section rd-section--muted px-6 lg:px-10 mt-8 rounded-t-[2rem] sm:rounded-t-[2.5rem]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14" data-animate>
        <p class="rd-label mb-3">What Drives Us</p>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-4">Our Core Values</h2>
        <div class="w-12 h-1 bg-red-600 mx-auto rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
            title: 'Quality',
            desc: 'We never compromise on the standard of our work. Every project receives the same meticulous attention to detail, regardless of scale.',
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
            title: 'Reliability',
            desc: 'Our clients know that when Reynolds Dryline commits to a programme, we deliver. On time, every time.',
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />`,
            title: 'Partnership',
            desc: 'We build long-term relationships with contractors and clients, working collaboratively to achieve the best outcomes for every project.',
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
            title: 'Innovation',
            desc: 'We continuously invest in our people, processes, and techniques to stay at the forefront of the building finishes sector.',
          },
        ].map((val, i) => (
          <div
            class="rd-panel rd-hover-bar p-8 border-t-4 border-t-red-600"
            data-animate
            data-delay={`${i * 100}`}
          >
            <div class="w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={val.icon} />
            </div>
            <h3 class="text-xl font-black text-gray-900 mb-3">{val.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{val.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="rd-section rd-section--dark px-6 lg:px-10 !py-16">
    <div class="max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 text-center">
      {[
        { label: 'Year Founded', target: 1963, prefix: '', suffix: '', plain: true },
        { label: 'Years Experience', target: 60, prefix: '', suffix: '+' },
        { label: 'Projects Delivered', target: 950, prefix: '£', suffix: 'm+' },
        { label: 'Coverage', text: 'UK Wide' },
      ].map((stat, i) => (
        <div
          class="rd-hover-bar rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-8 lg:py-10 transition-colors duration-300 hover:border-red-500/50"
          data-animate
          data-delay={`${i * 100}`}
        >
          {'text' in stat && stat.text ? (
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-2">{stat.text}</div>
          ) : (
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-2">
              <span
                data-counter
                data-target={stat.target}
                data-prefix={stat.prefix}
                data-suffix={stat.suffix}
                data-plain={stat.plain ? 'true' : undefined}
              >
                {`${stat.prefix}${stat.target}${stat.suffix}`}
              </span>
            </div>
          )}
          <div class="text-white/50 text-xs sm:text-sm font-bold tracking-widest uppercase">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

</ReynoldsLayout>

<script is:inline data-astro-rerun>
  (function () {
    const counters = document.querySelectorAll('[data-counter]');
    if (!counters.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const numberFormatter = new Intl.NumberFormat('en-GB');
    const animationDurationMs = 1600;

    function easeOutStandard(progress) {
      return 1 - Math.pow(1 - progress, 4);
    }

    function renderCounter(el, value) {
      const prefix = el.getAttribute('data-prefix') || '';
      const suffix = el.getAttribute('data-suffix') || '';
      const plain = el.getAttribute('data-plain') === 'true';
      const formatted = plain ? String(value) : numberFormatter.format(value);
      el.textContent = `${prefix}${formatted}${suffix}`;
    }

    function animateCounter(el) {
      const target = Number(el.getAttribute('data-target') || '0');
      if (!Number.isFinite(target) || target <= 0) {
        renderCounter(el, 0);
        return;
      }
      if (prefersReducedMotion) {
        renderCounter(el, target);
        return;
      }

      renderCounter(el, 0);
      const start = performance.now();

      function tick(now) {
        const progress = Math.min((now - start) / animationDurationMs, 1);
        const eased = easeOutStandard(progress);
        renderCounter(el, Math.round(target * eased));

        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      }

      requestAnimationFrame(tick);
    }

    if (typeof window.IntersectionObserver !== 'function') {
      counters.forEach((counter) => {
        const target = Number(counter.getAttribute('data-target') || '0');
        renderCounter(counter, Number.isFinite(target) && target > 0 ? target : 0);
      });
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        animateCounter(el);
        observer.unobserve(el);
      });
    }, { threshold: 0.45 });

    counters.forEach((counter) => observer.observe(counter));
  })();
</script>
