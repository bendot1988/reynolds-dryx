---
import ReynoldsLayout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<ReynoldsLayout
  title="Contact Reynolds Dryline | Mountsorrel Head Office"
  description="Contact Reynolds Dryline in Mountsorrel, Leicestershire for drylining and building finishes enquiries. Nationwide delivery — call 01509 816 600."
  canonical="https://www.reynoldsdryline.co.uk/contact"
>

  <PageHero
    title="Get in Touch"
    subtitle="Whether you have a project enquiry, want to discuss a tender, or simply want to learn more about our services — we'd love to hear from you."
    breadcrumb="Contact Us"
  />

  <!-- Contact Content -->
  <section class="bg-white py-20 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Contact Form (Fillout) -->
      <div>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-2">Send Us a Message</h2>
        <div class="w-10 h-1 bg-red-600 mb-8"></div>

        <div class="rd-panel overflow-clip p-4 sm:p-6">
          <div
            id="rd-fillout-contact"
            class="w-full min-h-[500px]"
            style="width:100%;height:500px;"
            data-fillout-id="gtEDrpbqJmus"
            data-fillout-embed-type="standard"
            data-fillout-inherit-parameters
            data-fillout-dynamic-resize
          ></div>
        </div>
      </div>

      <!-- Contact Info + Map -->
      <div>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-2">Contact Details</h2>
        <div class="w-10 h-1 bg-red-600 mb-8"></div>

        <div class="space-y-6 mb-10">
          <!-- Address -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-red-600 rounded-[10px] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Office Address</h3>
              <address class="text-gray-600 text-sm not-italic leading-relaxed">
                9 Quorn Business Quarter,<br />
                Loughborough Road,<br />
                Mountsorrel,<br />
                Leicestershire, LE12 7XF
              </address>
            </div>
          </div>

          <!-- Phone -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-red-600 rounded-[10px] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Phone</h3>
              <a href="tel:01509816600" class="rd-link-underline text-gray-600 text-sm hover:text-red-600 transition-colors duration-200">01509 816 600</a>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-red-600 rounded-[10px] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Email</h3>
              <a href="mailto:info@reynoldsltd.co.uk" class="rd-link-underline text-gray-600 text-sm hover:text-red-600 transition-colors duration-200">info@reynoldsltd.co.uk</a>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-red-600 rounded-[10px] flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-gray-900 mb-1">Office Hours</h3>
              <p class="text-gray-600 text-sm">Monday – Friday: 8:00am – 5:00pm</p>
              <p class="text-gray-600 text-sm">Saturday &amp; Sunday: Closed</p>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="h-72 bg-gray-100 rounded-[15px] overflow-hidden" id="rd-contact-map"></div>
      </div>
    </div>
  </section>

</ReynoldsLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline>
  (function () {
    function ensureFilloutEmbed() {
      var el = document.getElementById('rd-fillout-contact');
      if (!el) return;
      if (el.querySelector('iframe')) return;

      var existing = document.getElementById('rd-fillout-script');
      if (existing) existing.remove();

      // Drop Fillout’s global so a re-injected script will mount again after view transitions
      try {
        delete window.Fillout;
      } catch (e) {
        window.Fillout = undefined;
      }

      var s = document.createElement('script');
      s.id = 'rd-fillout-script';
      s.src = 'https://server.fillout.com/embed/v1/';
      s.async = true;
      document.body.appendChild(s);
    }

    document.addEventListener('astro:page-load', ensureFilloutEmbed);
  })();
</script>
<script>
  import L from 'leaflet';

  delete (L.Icon.Default.prototype as any)._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
    iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
  });

  let contactMap: L.Map | null = null;

  function initContactPage() {
    const mapEl = document.getElementById('rd-contact-map');

    if (mapEl && !mapEl.dataset.mapReady) {
      contactMap?.remove();
      contactMap = L.map('rd-contact-map', {
        center: [52.7175, -1.1474],
        zoom: 14,
        scrollWheelZoom: false,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
        subdomains: 'abcd',
        maxZoom: 19,
      }).addTo(contactMap);

      const redIcon = L.divIcon({
        className: '',
        html: '<div style="width:16px;height:16px;background:#E23125;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.4);"></div>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });

      L.marker([52.7175, -1.1474], { icon: redIcon })
        .addTo(contactMap)
        .bindPopup('<strong>Reynolds Dryline</strong><br>9 Quorn Business Quarter<br>Mountsorrel, LE12 7XF')
        .openPopup();

      mapEl.dataset.mapReady = 'true';
      requestAnimationFrame(() => contactMap?.invalidateSize());
    }
  }

  document.addEventListener('astro:page-load', initContactPage);
</script>
