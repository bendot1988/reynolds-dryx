<script is:inline data-astro-rerun>
  (function () {
    const counters = document.querySelectorAll('[data-counter]');
    if (!counters.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const numberFormatter = new Intl.NumberFormat('en-GB');
    const animationDurationMs = 1600;

    function easeOutStandard(progress) {
      return 1 - Math.pow(1 - progress, 4);
    }

    function renderCounter(el, value) {
      const prefix = el.getAttribute('data-prefix') || '';
      const suffix = el.getAttribute('data-suffix') || '';
      el.textContent = `${prefix}${numberFormatter.format(value)}${suffix}`;
    }

    function animateCounter(el) {
      const target = Number(el.getAttribute('data-target') || '0');
      if (!Number.isFinite(target) || target <= 0) {
        renderCounter(el, 0);
        return;
      }
      if (prefersReducedMotion) {
        renderCounter(el, target);
        return;
      }

      // Keep real values as static fallback, then animate once observed.
      renderCounter(el, 0);
      const start = performance.now();

      function tick(now) {
        const progress = Math.min((now - start) / animationDurationMs, 1);
        const eased = easeOutStandard(progress);
        renderCounter(el, Math.round(target * eased));

        if (progress < 1) {
          requestAnimationFrame(tick);
        }
      }

      requestAnimationFrame(tick);
    }

    if (typeof window.IntersectionObserver !== 'function') {
      counters.forEach((counter) => {
        const target = Number(counter.getAttribute('data-target') || '0');
        renderCounter(counter, Number.isFinite(target) && target > 0 ? target : 0);
      });
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        animateCounter(el);
        observer.unobserve(el);
      });
    }, { threshold: 0.45 });

    counters.forEach((counter) => observer.observe(counter));
  })();
</script>

<script is:inline data-astro-rerun>
  (function () {
    const root = document.getElementById('rd-testimonial-carousel');
    if (!root) return;

    const slides = Array.from(root.querySelectorAll('[data-testimonial-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-testimonial-dot]'));
    const previousButton = root.querySelector('[data-testimonial-prev]');
    const nextButton = root.querySelector('[data-testimonial-next]');
    if (!slides.length) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplayIntervalMs = 6500;
    let currentIndex = 0;
    let autoplayId = null;

    function render(index) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === currentIndex;
        slide.classList.toggle('hidden', !isActive);
        slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      dots.forEach((dot, dotIndex) => {
        const shape = dot.querySelector('[data-testimonial-dot-shape]');
        if (!(shape instanceof HTMLElement)) return;
        const isActive = dotIndex === currentIndex;
        shape.classList.toggle('w-8', isActive);
        shape.classList.toggle('bg-red-600', isActive);
        shape.classList.toggle('w-2.5', !isActive);
        shape.classList.toggle('bg-red-200', !isActive);
        shape.classList.toggle('hover:bg-red-300', !isActive);
      });
    }

    function stopAutoplay() {
      if (autoplayId) {
        window.clearInterval(autoplayId);
        autoplayId = null;
      }
    }

    function startAutoplay() {
      if (prefersReducedMotion) return;
      stopAutoplay();
      autoplayId = window.setInterval(() => render(currentIndex + 1), autoplayIntervalMs);
    }

    previousButton?.addEventListener('click', () => {
      render(currentIndex - 1);
      startAutoplay();
    });

    nextButton?.addEventListener('click', () => {
      render(currentIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot, dotIndex) => {
      dot.addEventListener('click', () => {
        render(dotIndex);
        startAutoplay();
      });
    });

    const swipeArea = root.querySelector('[data-testimonial-swipe]');
    let touchStartX = null;
    let touchStartY = null;
    const swipeMinPx = 48;

    swipeArea?.addEventListener(
      'touchstart',
      (e) => {
        if (e.touches.length !== 1) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true }
    );

    swipeArea?.addEventListener(
      'touchend',
      (e) => {
        if (touchStartX === null || touchStartY === null) return;
        const t = e.changedTouches[0];
        if (!t) {
          touchStartX = null;
          touchStartY = null;
          return;
        }
        const dx = t.clientX - touchStartX;
        const dy = t.clientY - touchStartY;
        touchStartX = null;
        touchStartY = null;
        const absX = Math.abs(dx);
        const absY = Math.abs(dy);
        if (absX < swipeMinPx || absX < absY) return;
        if (dx < 0) {
          render(currentIndex + 1);
        } else {
          render(currentIndex - 1);
        }
        startAutoplay();
      },
      { passive: true }
    );

    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', startAutoplay);
    root.addEventListener('focusin', stopAutoplay);
    root.addEventListener('focusout', startAutoplay);

    render(0);
    startAutoplay();
  })();
</script>

<script>
  type HeroCleanup = () => void;
  let heroCleanup: HeroCleanup | null = null;

  function tryPlay(video: HTMLVideoElement) {
    const playPromise = video.play();
    if (playPromise && typeof playPromise.catch === 'function') {
      playPromise.catch(() => {});
    }
  }

  /** Restart hero media after ClientRouter swaps — autoplay alone often won't. */
  function restartHeroVideo(heroVideo: HTMLVideoElement, prefersReducedMotion: boolean) {
    if (prefersReducedMotion) {
      heroVideo.pause();
      return;
    }

    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    heroVideo.loop = true;
    heroVideo.playsInline = true;
    heroVideo.setAttribute('playsinline', '');
    heroVideo.setAttribute('muted', '');
    heroVideo.setAttribute('autoplay', '');

    const src = heroVideo.getAttribute('src') || heroVideo.currentSrc;
    if (src) {
      // Re-assign src so the browser reloads media after a view-transition swap
      heroVideo.removeAttribute('src');
      heroVideo.src = src;
    }

    heroVideo.load();

    const onReady = () => tryPlay(heroVideo);
    heroVideo.addEventListener('loadeddata', onReady, { once: true });
    heroVideo.addEventListener('canplay', onReady, { once: true });
    tryPlay(heroVideo);
  }

  function initHeroVideo() {
    heroCleanup?.();
    heroCleanup = null;

    const heroVideo = document.getElementById('rd-hero-video');
    if (!(heroVideo instanceof HTMLVideoElement)) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const playHero = () => restartHeroVideo(heroVideo, prefersReducedMotion);

    playHero();

    const playButton = document.getElementById('rd-hero-play');
    const lightbox = document.getElementById('rd-hero-lightbox');
    const lightboxVideo = document.getElementById('rd-hero-lightbox-video');
    const closeButton = document.getElementById('rd-hero-lightbox-close');

    if (
      !(playButton instanceof HTMLButtonElement) ||
      !(lightbox instanceof HTMLDialogElement) ||
      !(lightboxVideo instanceof HTMLVideoElement) ||
      !(closeButton instanceof HTMLButtonElement)
    ) {
      return;
    }

    const controller = new AbortController();
    const { signal } = controller;

    function openLightbox() {
      heroVideo.pause();
      lightbox.showModal();
      tryPlay(lightboxVideo);
    }

    function closeLightbox() {
      lightboxVideo.pause();
      lightboxVideo.currentTime = 0;
      if (lightbox.open) lightbox.close();
      playHero();
    }

    playButton.addEventListener('click', openLightbox, { signal });
    closeButton.addEventListener('click', closeLightbox, { signal });
    lightbox.addEventListener(
      'click',
      (event) => {
        if (event.target === lightbox) closeLightbox();
      },
      { signal }
    );
    lightbox.addEventListener(
      'cancel',
      (event) => {
        event.preventDefault();
        closeLightbox();
      },
      { signal }
    );

    heroCleanup = () => controller.abort();
  }

  document.addEventListener('astro:page-load', initHeroVideo);
</script>

<!-- Leaflet map for coverage section -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script>
  import L from 'leaflet';

  delete (L.Icon.Default.prototype as any)._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
    iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
  });

  type LiveSite = { title: string; location: string; lat: number; lng: number };

  let homeLiveMap: L.Map | null = null;

  function readHomeLiveSites(): LiveSite[] {
    const dataEl = document.getElementById('rd-home-live-sites-data');
    if (!dataEl?.textContent) return [];
    try {
      const parsed = JSON.parse(dataEl.textContent);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function initHomeLiveMap() {
    const mapEl = document.getElementById('rd-home-live-map') as (HTMLElement & { _leaflet_id?: number }) | null;
    const sites = readHomeLiveSites();
    if (!mapEl || sites.length === 0) {
      homeLiveMap = null;
      return;
    }
    if (mapEl._leaflet_id) {
      window.setTimeout(() => homeLiveMap?.invalidateSize(), 50);
      return;
    }

    homeLiveMap?.remove();
    homeLiveMap = L.map(mapEl, {
      center: [52.6, -1.3],
      zoom: 7,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(homeLiveMap);

    const pulseIcon = L.divIcon({
      className: 'rd-live-marker',
      html: '<span class="rd-live-pulse"></span>',
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });

    const bounds: L.LatLngExpression[] = [];
    sites.forEach((site) => {
      bounds.push([site.lat, site.lng]);
      L.marker([site.lat, site.lng], { icon: pulseIcon })
        .addTo(homeLiveMap!)
        .bindPopup(`<strong>${site.title}</strong><br/><span style="color:#6b7280">${site.location}</span>`);
    });

    if (bounds.length > 1) {
      homeLiveMap.fitBounds(bounds as L.LatLngBoundsExpression, { padding: [40, 40], maxZoom: 9 });
    } else if (bounds.length === 1) {
      homeLiveMap.setView(bounds[0], 9);
    }

    window.setTimeout(() => homeLiveMap?.invalidateSize(), 50);
    window.setTimeout(() => homeLiveMap?.invalidateSize(), 250);
  }

  document.addEventListener('astro:page-load', initHomeLiveMap);
</script>

