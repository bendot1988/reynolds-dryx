---

<ReynoldsLayout
  title="Specialist Drylining Contractors | Reynolds Dryline"
  description="Reynolds Dryline delivers specialist drylining and building finishes across Leicestershire and the wider UK. Programme-led packages since 1963."
  canonical="https://www.reynoldsdryline.co.uk/"
>
  <Fragment slot="head">
    <link rel="preload" href="/assets/reynolds/hero-poster.jpg" as="image" fetchpriority="high" />
  </Fragment>


  <!-- ============================================================
       HERO SECTION — Full-screen video background
  ============================================================ -->
  <section class="rd-page-hero relative flex h-svh max-h-svh flex-col justify-end overflow-hidden bg-black">
    <video
      id="rd-hero-video"
      class="absolute inset-0 w-full h-full object-cover bg-black"
      src="/assets/reynolds/hero-video.mp4"
      poster="/assets/reynolds/hero-poster.jpg"
      preload="auto"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    ></video>
    <!-- Overlay: lighter up top so the film shows through; stronger at the bottom for text -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-black via-black/55 to-black/25"
      aria-hidden="true"
    ></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto w-full px-6 lg:px-10 pt-20 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:pb-8 lg:pb-12">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-red-600 text-white text-[0.65rem] sm:text-xs font-bold tracking-widest uppercase px-3 py-1.5 sm:px-4 sm:py-2 mb-3 sm:mb-6 rounded-[5px]" data-animate data-delay="0">
        Since 1963
      </div>

      <!-- Headline -->
      <h1 class="text-[2.15rem] sm:text-6xl lg:text-[5rem] font-black text-white leading-[1.12] sm:leading-[0.94] mb-3 sm:mb-6 max-w-3xl" data-animate data-delay="100">
        Providing Complete<br />
        <span class="text-red-500">Dryline</span> Solutions
      </h1>

      <!-- Subheading -->
      <p class="text-white/88 text-sm sm:text-xl lg:text-2xl max-w-3xl mb-5 sm:mb-10 leading-snug sm:leading-relaxed font-medium" data-animate data-delay="200">
        Leaders in specialist building finishes.<br class="hidden md:block" />
        <span class="hidden sm:inline">Fulfilling high-value projects to programme, budget, and unmatched quality standards.</span>
      </p>

      <!-- CTAs (.rd-hero-cta in global.css; footer band uses .rd-hero-cta--on-red) -->
      <div class="flex flex-row flex-wrap items-center gap-2.5 sm:gap-4" data-animate data-delay="300">
        <a href="/contact" class="rd-hero-cta rd-btn-primary justify-center !px-3.5 !py-2.5 !text-[0.7rem] sm:!px-6 sm:!py-3 sm:!text-[0.8rem]">
          Discuss Your Project
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/projects" class="rd-hero-cta rd-btn-outline justify-center !px-3.5 !py-2.5 !text-[0.7rem] sm:!px-6 sm:!py-3 sm:!text-[0.8rem]">
          View Projects
        </a>
        <button
          type="button"
          id="rd-hero-play"
          class="rd-hero-play rd-hero-cta rd-btn-outline justify-center !px-3.5 !py-2.5 !text-[0.7rem] sm:!px-6 sm:!py-3 sm:!text-[0.8rem]"
          aria-label="This is Reynolds"
          aria-haspopup="dialog"
          aria-controls="rd-hero-lightbox"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 text-red-500" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5.14v13.72L19 12 8 5.14z" />
          </svg>
          This is Reynolds
        </button>
      </div>
    </div>
  </section>

  <!-- Full film lightbox -->
  <dialog
    id="rd-hero-lightbox"
    class="rd-hero-lightbox fixed inset-0 z-[100] m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0"
    aria-label="Reynolds Dryline film"
  >
    <button
      type="button"
      id="rd-hero-lightbox-close"
      class="absolute top-4 right-4 z-10 inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/30 bg-black/50 text-white transition-colors hover:border-white hover:bg-white/10 sm:top-6 sm:right-6"
      aria-label="Close video"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <div class="relative w-full max-w-6xl px-4 sm:px-6">
      <video
        id="rd-hero-lightbox-video"
        class="aspect-video w-full bg-black"
        controls
        playsinline
        preload="none"
        poster="/assets/reynolds/hero-poster.jpg"
      >
        <source src="/assets/reynolds/hero-video-full.mp4" type="video/mp4" />
      </video>
    </div>
  </dialog>

  <!-- ============================================================
       TRUST STRIP — SIMPLE FULL-WIDTH CREDENTIALS BAND
  ============================================================ -->
  <section class="w-full bg-black border-y border-white/10">
    <div class="w-full grid grid-cols-2 lg:grid-cols-4">
      <p class="rd-cred-item py-4 px-4 text-center text-white/75 text-[0.68rem] font-bold tracking-[0.14em] uppercase border-b border-white/10 lg:border-b-0 lg:border-r lg:border-white/10">
        H&amp;S Focused
      </p>
      <p class="rd-cred-item py-4 px-4 text-center text-white/75 text-[0.68rem] font-bold tracking-[0.14em] uppercase border-b border-white/10 lg:border-b-0 lg:border-r lg:border-white/10">
        Compliance Led
      </p>
      <p class="rd-cred-item py-4 px-4 text-center text-white/75 text-[0.68rem] font-bold tracking-[0.14em] uppercase lg:border-r lg:border-white/10">
        Quality Assured
      </p>
      <p class="rd-cred-item py-4 px-4 text-center text-white/75 text-[0.68rem] font-bold tracking-[0.14em] uppercase">
        Fully Insured
      </p>
    </div>
  </section>

  <!-- ============================================================
       WHAT WE OFFER — SERVICE GRID
  ============================================================ -->
  <section class="rd-section rd-section--surface px-6 lg:px-10 pt-10 lg:pt-12 pb-14 lg:pb-16">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12" data-animate>
        <p class="rd-label mb-3">What We Offer</p>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-3">Core Services, Built to Deliver</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">A complete drylining package from partitioning and ceilings to SFS, plastering and fire stopping.</p>
      </div>

      <div class="rd-hscroll">
        <div class="rd-hscroll__track md:grid md:grid-cols-2 lg:grid-cols-6 md:gap-6 lg:gap-7">
          <article class="rd-hscroll__item rd-panel group overflow-clip lg:col-span-2" data-animate>
            <img src="/assets/reynolds/services/partitions.png" alt="Metal stud partition installation" class="w-full h-52 lg:h-56 object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" />
            <div class="p-6">
              <h3 class="text-xl font-black text-gray-900 mb-2">Partitions</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Metal stud partition systems designed for acoustic performance, durability, and efficient installation.</p>
            </div>
          </article>

          <article class="rd-hscroll__item rd-panel group overflow-clip lg:col-span-2" data-animate data-delay="100">
            <img src="/assets/reynolds/services/sfs.png" alt="Structural framing system façade package" class="w-full h-52 lg:h-56 object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" />
            <div class="p-6">
              <h3 class="text-xl font-black text-gray-900 mb-2">SFS</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Structural framing system packages coordinated for façade interfaces, speed, and buildability.</p>
            </div>
          </article>

          <article class="rd-hscroll__item rd-panel group overflow-clip lg:col-span-2" data-animate data-delay="180">
            <picture>
              <source srcset="/assets/reynolds/services/ceilings.webp" type="image/webp" />
              <img src="/assets/reynolds/services/ceilings.jpg" alt="Completed suspended ceiling in a commercial office fit-out" class="w-full h-52 lg:h-56 object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" />
            </picture>
            <div class="p-6">
              <h3 class="text-xl font-black text-gray-900 mb-2">Ceilings</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Suspended ceiling solutions across commercial and residential schemes with precise finishing.</p>
            </div>
          </article>

          <article class="rd-hscroll__item rd-panel group overflow-clip lg:col-span-3" data-animate data-delay="260">
            <img src="/assets/reynolds/services/plastering.png" alt="Plastering works on a major site" class="w-full h-52 lg:h-56 object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" />
            <div class="p-6">
              <h3 class="text-xl font-black text-gray-900 mb-2">Plastering</h3>
              <p class="text-gray-600 text-sm leading-relaxed">High-quality skim and tape-and-joint finishes delivered to programme with clean handover standards.</p>
            </div>
          </article>

          <article class="rd-hscroll__item rd-panel group overflow-clip lg:col-span-3" data-animate data-delay="320">
            <img src="/assets/reynolds/services/fire-stopping.png" alt="Fire stopping installation on a commercial site" class="w-full h-52 lg:h-56 object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" />
            <div class="p-6">
              <h3 class="text-xl font-black text-gray-900 mb-2">Fire Stopping</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Compliant passive fire protection for walls, floors and ceilings, installed with tested systems across residential, commercial and industrial projects.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CORE COMPETENCIES / SECTORS — with hover-reveal descriptions
  ============================================================ -->
  <section class="rd-section rd-section--surface px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <!-- Section header -->
      <div class="text-center mb-14" data-animate>
        <p class="rd-label mb-3">Core Competencies</p>
        <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-3">Expertise Across All Sectors</h2>
        <div class="w-12 h-1 bg-red-600 mx-auto"></div>
      </div>

      <!-- Sector strip — horizontal scroll on mobile, 2-col grid from md -->
      <div class="rd-hscroll">
        <div class="rd-hscroll__track md:grid md:grid-cols-2 md:gap-6">

        <!-- Multi-Room Residential -->
        <div class="rd-hscroll__item rd-sector-card group rounded-[15px] overflow-clip" data-animate>
          <img
            src="/assets/reynolds/project-lisbon-st-leeds.jpg"
            alt="Multi-Room Residential drylining project"
            class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="rd-sector-card-overlay rounded-[15px]"></div>
          <!-- Always-visible title -->
          <div class="rd-sector-card-content">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white mb-3 md:mb-0 transition-all duration-300 md:group-hover:mb-3">Multi-Room Residential</h3>
            <!-- Description: always visible on mobile; hover-reveal from md up -->
            <p class="text-white/80 text-sm leading-relaxed mb-4 max-h-40 opacity-100 overflow-hidden md:max-h-0 md:opacity-0 md:group-hover:max-h-40 md:group-hover:opacity-100 transition-all duration-500 ease-out">
              High-density residential projects, including student accommodation and luxury apartments, delivering acoustic performance and superior finishes.
            </p>
            <a href="/services" class="rd-link-underline inline-flex items-center gap-2 text-white text-sm font-bold tracking-wider uppercase opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:text-red-400">
              Learn More
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Commercial Office Space -->
        <div class="rd-hscroll__item rd-sector-card group rounded-[15px] overflow-clip" data-animate data-delay="100">
          <picture>
            <source srcset="/assets/reynolds/parkside-coventry-hero.webp" type="image/webp" />
            <img
              src="/assets/reynolds/parkside-coventry-hero.png"
              alt="Commercial office development exterior drylining project"
              class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="rd-sector-card-overlay rounded-[15px]"></div>
          <div class="rd-sector-card-content">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
              </svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white mb-3 md:mb-0 transition-all duration-300 md:group-hover:mb-3">Commercial Office Space</h3>
            <p class="text-white/80 text-sm leading-relaxed mb-4 max-h-40 opacity-100 overflow-hidden md:max-h-0 md:opacity-0 md:group-hover:max-h-40 md:group-hover:opacity-100 transition-all duration-500 ease-out">
              Bespoke drylining and ceiling solutions for modern corporate environments, focusing on aesthetics and functionality.
            </p>
            <a href="/services" class="rd-link-underline inline-flex items-center gap-2 text-white text-sm font-bold tracking-wider uppercase opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:text-red-400">
              Learn More
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Industrial & Warehousing -->
        <div class="rd-hscroll__item rd-sector-card group rounded-[15px] overflow-clip" data-animate data-delay="200">
          <img
            src="/assets/reynolds/drylining-01.jpg"
            alt="Industrial and Warehousing drylining project"
            class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="rd-sector-card-overlay rounded-[15px]"></div>
          <div class="rd-sector-card-content">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-6 h-6 text-red-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 3c1.93 0 3.5 1.57 3.5 3.5S13.93 13 12 13s-3.5-1.57-3.5-3.5S10.07 6 12 6zm7 13H5v-.23c0-.62.28-1.2.76-1.58C7.47 15.82 9.64 15 12 15s4.53.82 6.24 2.19c.48.38.76.97.76 1.58V19z"/>
              </svg>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-white mb-3 md:mb-0 transition-all duration-300 md:group-hover:mb-3">Industrial &amp; Warehousing</h3>
            <p class="text-white/80 text-sm leading-relaxed mb-4 max-h-40 opacity-100 overflow-hidden md:max-h-0 md:opacity-0 md:group-hover:max-h-40 md:group-hover:opacity-100 transition-all duration-500 ease-out">
              Complete drylining packages for warehouses and industrial units, including office areas that need strong fire and acoustic performance.
            </p>
            <a href="/services" class="rd-link-underline inline-flex items-center gap-2 text-white text-sm font-bold tracking-wider uppercase opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-all duration-300 hover:text-red-400">
              Learn More
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Hotels & Leisure -->
        <div class="rd-hscroll__item rd-sector-card group rounded-[15px] overflow-clip" data-animate data-delay="300">
          <img
            src="/assets/reynolds/project-bletchley.jpg"
            alt="Hotels and Leisure drylining project"
            class="w-full h-80 object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="rd-sector-card-overlay rounded-[15px]"></div>
          <div class="rd-sector-card-content">
