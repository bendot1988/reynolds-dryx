---
import { getCollection, render } from 'astro:content';
import ReynoldsLayout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const otherPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<ReynoldsLayout
  title={`${post.data.title} | Reynolds Dryline News`}
  description={post.data.description}
  canonical={`https://www.reynoldsdryline.co.uk/news/${post.id}`}
  ogImage={post.data.image}
>
  <Header currentPath="/news" />

  <PageHero
    title={post.data.title}
    subtitle={post.data.description}
    breadcrumb={post.data.category}
    bgImage={post.data.image}
    bgPosition="center"
  />

  <section class="bg-white py-16 lg:py-20 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14">

      {/* ─── Main article column (2/3) ─── */}
      <article class="lg:col-span-2">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 mb-8 pb-6 border-b border-gray-200">
          <time class="font-semibold text-gray-700">{formatDate(new Date(post.data.pubDate))}</time>
          <span class="text-gray-300">·</span>
          <span>{post.data.author}</span>
        </div>

        <div
          class="prose prose-lg prose-headings:font-black prose-headings:text-gray-900 prose-p:text-gray-700 prose-p:leading-relaxed prose-a:text-red-600 max-w-none"
        >
          <Content />
        </div>

        <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <a
            href="/news"
            class="rd-link-underline inline-flex items-center gap-2 text-red-600 text-sm font-bold tracking-wider uppercase hover:gap-3 transition-all duration-200"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            All News
          </a>
          <a href="/contact" class="rd-btn-primary">
            Discuss Your Project
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </article>

      {/* ─── Sidebar (1/3) ─── */}
      <aside class="lg:col-span-1 space-y-8">
        {otherPosts.length > 0 && (
          <div class="rd-panel p-6">
            <p class="rd-label mb-5">More from Reynolds</p>
            <ul class="space-y-5 m-0 p-0 list-none">
              {otherPosts.map((other) => (
                <li class="border-b border-gray-100 last:border-b-0 pb-5 last:pb-0">
                  <a href={`/news/${other.id}`} class="group flex gap-4 items-start">
                    {other.data.image && (
                      <div class="flex-shrink-0 overflow-hidden rounded-[10px] w-20 h-20 border border-gray-100">
                        <img
                          src={other.data.image}
                          alt={other.data.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                    <div class="min-w-0 flex-1">
                      <p class="text-[0.62rem] font-bold tracking-[0.13em] uppercase text-red-600 mb-1">
                        {other.data.category}
                      </p>
                      <h3 class="text-sm font-black text-gray-900 leading-snug mb-1 group-hover:text-red-600 transition-colors duration-200">
                        {other.data.title}
                      </h3>
                      <time class="text-xs text-gray-400">{formatDate(new Date(other.data.pubDate))}</time>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/news"
              class="rd-link-underline mt-6 inline-flex items-center gap-2 text-red-600 text-xs font-bold tracking-[0.15em] uppercase hover:gap-3 transition-all duration-200"
            >
              View All News
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        )}

        <div class="bg-red-600 text-white rounded-[15px] border border-red-700/50 p-6 lg:p-7 shadow-[0_18px_40px_-18px_rgba(226,49,37,0.55)]">
          <p class="text-[0.62rem] font-bold tracking-[0.18em] uppercase text-white/80 mb-3">
            Specialist Drylining
          </p>
          <h3 class="text-2xl font-black text-white mb-3 leading-tight">Have a Project in Mind?</h3>
          <p class="text-white/90 text-sm leading-relaxed mb-5">
            Talk to our team about your next build, refurbishment, or fit-out. Trusted by the UK's leading contractors since 1963.
          </p>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 bg-white text-red-600 px-4 py-2.5 text-xs font-bold tracking-widest uppercase rounded-[8px] hover:bg-gray-50 hover:gap-3 transition-all duration-200"
          >
            Get in Touch
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <Footer />
</ReynoldsLayout>
