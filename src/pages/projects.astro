---
import ReynoldsLayout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

// Get CMS projects if available
let cmsProjects: any[] = [];
try {
  cmsProjects = await getCollection('projects');
} catch (e) {
  // Collection may not exist yet
}

// Static fallback projects
const staticProjects = [
  {
    title: 'Progress House',
    location: 'Coventry, UK',
    contractor: 'Winvic',
    value: '£3.60m',
    status: 'Live',
    sector: 'Residential',
    lat: 52.3833,
    lng: -1.5615,
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Partitioning', 'Ceilings', 'Plastering'],
    description:
      'Progress House Student Accommodation, Coventry is a purpose-built student accommodation development delivering 544 modern en-suite bedrooms, together with high-quality communal, study and wellbeing spaces. Located close to the University of Warwick, the scheme has been designed to provide an outstanding living environment that supports both academic success and student wellbeing.',
  },
  {
    title: 'Loughborough University',
    location: 'Loughborough, UK',
    contractor: 'Graham',
    value: '£3.61m',
    status: 'Live',
    sector: 'Residential',
    lat: 52.765,
    lng: -1.2321,
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['SFS', 'Partitioning', 'Ceilings', 'Plastering'],
    description:
      "Reynolds Dryline is delivering the drylining package for GRAHAM on Loughborough University's landmark new purpose-built student accommodation development. The £59 million scheme will provide 552 high-quality en-suite student bedrooms across five contemporary accommodation blocks, creating modern living spaces that enhance the student experience and support the University's continued growth.",
  },
  {
    title: 'Camphill',
    location: 'Birmingham, UK',
    contractor: 'Winvic',
    value: '£3.41m',
    status: 'Live',
    sector: 'Residential',
    lat: 52.4755,
    lng: -1.882,
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Partitioning', 'Ceilings', 'Plastering'],
    description:
      'Reynolds Dryline is delivering specialist drylining works on the Camphill development in Birmingham, supporting Winvic Construction on this large-scale residential regeneration project. Our scope included internal partitions, plastering and associated drylining systems, helping create high-quality modern living spaces within the development.',
  },
  {
    title: 'Browells Lane',
    location: 'Feltham, UK',
    contractor: 'TanRo',
    value: '£380k',
    status: 'Complete 2026',
    sector: 'Industrial',
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Partitioning', 'Ceilings', 'Plastering'],
    description:
      'Reynolds Dryline was appointed by TanRo to deliver the complete internal drylining package for the Browells Lane industrial development in Feltham. The project comprised the construction of six high-quality industrial and warehouse units, providing approximately 75,000 sq ft of modern commercial space designed to achieve BREEAM Outstanding and EPC A+ standards.',
  },
  {
    title: 'Castle Rock School',
    location: 'Coalville, UK',
    contractor: 'Graham',
    value: '£1.9m',
    status: 'Live',
    sector: 'Commercial',
    lat: 52.7246,
    lng: -1.3649,
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['SFS', 'Partitioning', 'Ceilings', 'Plastering'],
    description:
      "Reynolds Dryline is delivering the drylining package for GRAHAM's landmark redevelopment of The Castle Rock School in Coalville, Leicestershire. The £37 million Department for Education project is transforming the existing secondary school campus through the construction of a modern two-storey teaching facility, refurbishment of retained buildings, and the creation of high-quality learning environments for up to 1,550 students.",
  },
  {
    title: 'University of Staffordshire Student Village',
    location: 'Stoke-on-Trent, UK',
    contractor: 'Willmott Dixon',
    value: '£4.9m',
    status: 'Completed 2026',
    sector: 'Residential',
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Drylining', 'Ceilings', 'Plastering'],
    description:
      'The University of Staffordshire Student Village is a landmark £100 million development delivering high-quality, sustainable student accommodation and a state-of-the-art community hub on the Stoke-on-Trent campus. Designed to enhance the student experience, the scheme includes purpose-built accommodation, modern social and study spaces, and a net-zero operational hub built to Passivhaus design principles.',
  },
  {
    title: 'South Holland Health & Wellbeing Hub',
    location: 'Spalding, UK',
    contractor: 'Willmott Dixon',
    value: '£500k',
    status: 'Live',
    sector: 'Hotels & Leisure',
    lat: 52.787,
    lng: -0.1518,
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Partitioning', 'Ceilings', 'Plastering'],
    description:
      'South Holland Health & Wellbeing Hub, Spalding is a modern leisure and wellbeing facility designed to promote healthier lifestyles through high-quality fitness, recreation and community spaces. The development features a state-of-the-art gym, swimming facilities, studios and flexible community areas, creating a welcoming environment for people of all ages to exercise, socialise and improve their overall wellbeing.',
  },
  {
    title: 'Waltham Cross Industrial Development',
    location: 'Waltham Cross, UK',
    contractor: 'TanRo',
    value: '£230k',
    status: 'Complete 2026',
    sector: 'Industrial',
    image: '/assets/reynolds/project-image-coming-soon.svg',
    services: ['Partitioning', 'Ceilings', 'Plastering'],
    description:
      'The Waltham Cross Industrial Development is a high-specification 60,000 sq ft industrial and logistics facility being delivered for TanRo on behalf of Wrenbridge. The project involves the complete demolition of the existing site before the construction of a modern warehouse with integrated first-floor office accommodation.',
  },
  {
    title: 'Bendigo Building',
    location: 'Nottingham, UK',
    contractor: 'Graham',
    value: '£4.4m',
    status: 'Completed',
    sector: 'Residential',
    image: '/assets/reynolds/project-28rs.jpg',
    services: ['Metal Stud Partitioning', 'Suspended Ceilings', 'SFS'],
    description: 'A major residential development in Nottingham city centre, delivering high-quality drylining and ceiling solutions across multiple floors.',
  },
  {
    title: 'Lancaster Street',
    location: 'Birmingham, UK',
    contractor: 'Winvic',
    value: '£4.4m',
    status: 'Completed',
    sector: 'Residential',
    image: '/assets/reynolds/project-untitled.jpg',
    services: ['Metal Stud Partitioning', 'Insulation', 'Plastering'],
    description: 'Student accommodation development in Birmingham, requiring precise acoustic performance and high-quality finishes throughout.',
  },
  {
    title: 'Lisbon Street, Leeds',
    location: 'Leeds, UK',
    contractor: 'Winvic',
    value: '£3.2m',
    status: 'Completed',
    sector: 'Residential',
    image: '/assets/reynolds/project-lisbon-st-leeds.jpg',
    services: ['Metal Stud Partitioning', 'Suspended Ceilings', 'Plastering'],
    description: 'A high-density residential project in Leeds, delivering complete building finishes to a tight programme.',
  },
  {
    title: 'Bletchley View',
    location: 'Milton Keynes, UK',
    contractor: 'Bowmer Kirkland',
    value: '£2.8m',
    status: 'Completed',
    sector: 'Residential',
    image: '/assets/reynolds/project-bletchley.jpg',
    services: ['SFS', 'Metal Stud Partitioning', 'Insulation'],
    description: 'Forward-funded residential development in Milton Keynes, featuring complex SFS external wall systems.',
  },
  {
    title: 'Commercial Office Development',
    location: 'East Midlands, UK',
    contractor: 'Galliford Try',
    value: '£1.9m',
    status: 'Completed',
    sector: 'Commercial',
    image: '/assets/reynolds/drylining-01.jpg',
    services: ['Metal Stud Partitioning', 'Suspended Ceilings'],
    description: 'Modern commercial office space requiring bespoke ceiling and partition solutions to meet client specifications.',
  },
  {
    title: 'Industrial Warehouse Complex',
    location: 'Midlands, UK',
    contractor: 'Engie',
    value: '£2.1m',
    status: 'Completed',
    sector: 'Industrial',
    image: '/assets/reynolds/project-building.jpg',
    services: ['Metal Stud Partitioning', 'Suspended Ceilings', 'Fire Barriers'],
    description: 'Large-scale industrial warehouse with integrated multi-storey office block, requiring specialist fire and acoustic solutions.',
  },
];

const projects = cmsProjects.length > 0 ? cmsProjects : staticProjects;
const sectors = ['All', 'Residential', 'Commercial', 'Industrial', 'Hotels & Leisure'];
const statusFilters = ['All', 'Live', 'Complete'];

const isLiveStatus = (status: string) => status === 'Live' || status === 'On Going';
const sortedProjects = [...staticProjects].sort((a, b) => {
  const aLive = isLiveStatus(a.status) ? 0 : 1;
  const bLive = isLiveStatus(b.status) ? 0 : 1;
  return aLive - bLive;
});

const contractorLogos: Record<string, string> = {
  Winvic: '/assets/reynolds/partner-winvic.png',
  Graham: '/assets/reynolds/partner-graham.png',
  TanRo: '/assets/reynolds/partner-tanro.png',
  'Willmott Dixon': '/assets/reynolds/partner-willmott-dixon.png',
  'Bowmer Kirkland': '/assets/reynolds/partner-bowmer-kirkland.png',
  'Galliford Try': '/assets/reynolds/partner-gallifordtry.png',
  Engie: '/assets/reynolds/partner-engie.png',
};

const liveSites = staticProjects
  .filter((project) => isLiveStatus(project.status) && typeof project.lat === 'number' && typeof project.lng === 'number')
  .map((project) => ({
    title: project.title,
    location: project.location,
    lat: project.lat as number,
    lng: project.lng as number,
  }));
---

<ReynoldsLayout
  title="Project Portfolio | Reynolds Dryline"
  description="Browse Reynolds Dryline's project portfolio. We have delivered high-value drylining and building finishes projects across the UK for leading contractors."
  canonical="https://www.reynoldsdryline.co.uk/projects"
>
  <Header currentPath="/projects" />

  <PageHero
    title="Project Portfolio"
    subtitle="A selection of our completed and ongoing projects, showcasing the breadth and quality of our work across the UK."
    breadcrumb="Our Work"
    bgImage="/assets/reynolds/services/plastering.png"
    bgPosition="center"
  />

  <!-- Filter bar -->
  <section class="bg-white border-b border-gray-200 px-6 lg:px-10 py-4 md:py-5 sticky top-16 z-30">
    <div class="max-w-7xl mx-auto space-y-3">
      <!-- Mobile: compact dropdowns + always-open search -->
      <div class="space-y-3 md:hidden">
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="mb-1.5 block text-[0.65rem] font-bold tracking-widest uppercase text-gray-500">Filter</span>
            <select
              id="rd-sector-select"
              class="rd-mobile-select w-full appearance-none border border-gray-300 bg-white px-3 py-2.5 pr-9 text-xs font-bold tracking-widest uppercase text-gray-700"
            >
              {sectors.map((sector) => (
                <option value={sector}>{sector === 'All' ? 'All sectors' : sector}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="mb-1.5 block text-[0.65rem] font-bold tracking-widest uppercase text-gray-500">Status</span>
            <select
              id="rd-status-select"
              class="rd-mobile-select w-full appearance-none border border-gray-300 bg-white px-3 py-2.5 pr-9 text-xs font-bold tracking-widest uppercase text-gray-700"
            >
              {statusFilters.map((status) => (
                <option value={status}>{status === 'All' ? 'All statuses' : status}</option>
              ))}
            </select>
          </label>
        </div>

        <div class="flex h-11 items-center border border-gray-300 bg-white">
          <svg class="ml-3 h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
          </svg>
          <input
            type="search"
            id="rd-project-search-input-mobile"
            class="h-full w-full min-w-0 border-0 bg-transparent px-3 text-sm text-gray-900 outline-none placeholder:text-gray-400"
            placeholder="Search projects…"
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Desktop: button filters + expandable search -->
      <div class="hidden md:block space-y-3">
        <div class="flex flex-wrap gap-3 items-center justify-between">
          <div class="flex flex-wrap gap-3 items-center">
            <span class="text-xs font-bold tracking-widest uppercase text-gray-500 mr-2">Filter:</span>
            {sectors.map(sector => (
              <button
                type="button"
                class="rd-filter-btn text-xs font-bold tracking-widest uppercase px-4 py-2 border transition-all duration-200"
                data-filter-type="sector"
                data-sector={sector}
                class:list={[
                  sector === 'All'
                    ? 'bg-red-600 text-white border-red-600'
                    : 'bg-white text-gray-600 border-gray-300 hover:border-red-600 hover:text-red-600'
                ]}
              >
                {sector}
              </button>
            ))}
          </div>

          <div id="rd-project-search" class="rd-project-search relative ml-auto">
            <button
              type="button"
              id="rd-project-search-toggle"
              class="inline-flex h-9 w-9 items-center justify-center border border-gray-300 text-gray-600 transition-colors duration-200 hover:border-red-600 hover:text-red-600"
              aria-label="Search projects"
              aria-expanded="false"
              aria-controls="rd-project-search-input"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
              </svg>
            </button>
            <div
              id="rd-project-search-panel"
              class="rd-project-search-panel absolute right-0 top-0 flex h-9 items-center overflow-hidden border border-red-600 bg-white opacity-0 pointer-events-none"
            >
              <svg class="ml-3 h-4 w-4 shrink-0 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
              </svg>
              <input
                type="search"
                id="rd-project-search-input"
                class="h-full w-full min-w-0 border-0 bg-transparent px-3 text-sm text-gray-900 outline-none placeholder:text-gray-400"
                placeholder="Search projects…"
                autocomplete="off"
              />
              <button
                type="button"
                id="rd-project-search-close"
                class="inline-flex h-9 w-9 shrink-0 items-center justify-center text-gray-500 transition-colors hover:text-red-600"
                aria-label="Close search"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3 items-center">
          <span class="text-xs font-bold tracking-widest uppercase text-gray-500 mr-2">Status:</span>
          {statusFilters.map((status) => (
            <button
              type="button"
              class="rd-status-btn text-xs font-bold tracking-widest uppercase px-4 py-2 border transition-all duration-200"
              data-status={status}
              class:list={[
                status === 'All'
                  ? 'bg-slate-800 text-white border-slate-800'
                  : 'bg-white text-gray-600 border-gray-300 hover:border-slate-800 hover:text-slate-800'
              ]}
            >
              {status}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Live sites map accordion -->
  <section class="bg-white border-b border-gray-200 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <button
        type="button"
        id="rd-live-sites-toggle"
        class="flex w-full items-center justify-between gap-4 py-4 text-left"
        aria-expanded="false"
        aria-controls="rd-live-sites-panel"
      >
        <span class="inline-flex items-center gap-3">
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-500/60"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-red-600"></span>
          </span>
          <span class="text-sm font-bold tracking-widest uppercase text-gray-900">Show live sites</span>
          <span class="text-xs font-semibold text-gray-500 normal-case tracking-normal">{liveSites.length} active</span>
        </span>
        <svg id="rd-live-sites-chevron" class="h-5 w-5 text-gray-500 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="rd-live-sites-panel" class="rd-live-sites-panel overflow-hidden" hidden>
        <div class="pb-6">
          <div class="rd-panel overflow-hidden border border-gray-200">
            <div id="rd-live-sites-map" class="h-72 sm:h-80 lg:h-96 w-full bg-gray-100"></div>
          </div>
          <p class="mt-3 text-xs text-gray-500">Pulsing markers show current live Reynolds Dryline sites across the UK.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects grid -->
  <section class="bg-white py-16 px-6 lg:px-10">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="rd-projects-grid">
        {sortedProjects.map((project, i) => {
          const isOngoing = isLiveStatus(project.status);
          const statusLabel = isOngoing ? (project.status === 'Live' ? 'Live' : 'On Going') : 'Complete';
          const contractorLogo = contractorLogos[project.contractor];
          return (
          <article
            class="rd-project-item group bg-white border border-gray-200 overflow-hidden hover:shadow-xl transition-shadow duration-300"
            data-sector={project.sector}
            data-status={isOngoing ? 'Live' : 'Complete'}
            data-search={`${project.title} ${project.location} ${project.contractor} ${project.value} ${project.status} ${project.sector} ${project.services.join(' ')} ${project.description}`.toLowerCase()}
            data-animate
            data-delay={`${(i % 3) * 100}`}
          >
            <div class="relative overflow-hidden">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span
                class:list={[
                  'absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 px-3 py-1.5 text-[0.65rem] font-bold tracking-widest uppercase text-white shadow-sm',
                  isOngoing ? 'bg-slate-800' : 'bg-emerald-600',
                ]}
              >
                <span class="h-1.5 w-1.5 rounded-full bg-white/90" aria-hidden="true"></span>
                {statusLabel}
              </span>
            </div>
            <div class="p-6">
              <!-- Sector badge -->
              <span class="inline-block bg-red-600 text-white text-xs font-bold tracking-widest uppercase px-3 py-1 mb-3">
                {project.sector}
              </span>

              <h3 class="text-2xl font-black text-gray-900 mb-1">{project.title}</h3>
              <p class="text-gray-500 text-sm mb-4">{project.location}</p>
              <p class="text-gray-600 text-sm leading-relaxed mb-5">{project.description}</p>

              <!-- Project details -->
              <div class="grid grid-cols-2 gap-3 mb-5 text-xs">
                <div class="bg-gray-50 p-3 flex items-center justify-center min-h-[4.5rem]">
                  {contractorLogo ? (
                    <img
                      src={contractorLogo}
                      alt={project.contractor}
                      class="max-h-10 w-auto max-w-full object-contain"
                      loading="lazy"
                    />
                  ) : (
                    <span class="text-gray-900 font-semibold">{project.contractor}</span>
                  )}
                </div>
                <div class="bg-gray-50 p-3 flex flex-col justify-center">
                  <span class="block text-gray-400 font-bold tracking-widest uppercase mb-1">Value</span>
                  <span class="text-gray-900 font-semibold">{project.value}</span>
                </div>
              </div>

              <!-- Services tags -->
              <div class="flex flex-wrap gap-2">
                {project.services.map(service => (
                  <span class="text-xs font-semibold px-2 py-1 bg-gray-100 text-gray-600">{service}</span>
                ))}
              </div>
            </div>
          </article>
          );
        })}
      </div>
      <p id="rd-projects-empty" class="hidden mt-10 text-center text-gray-500 text-sm font-medium" hidden>
        No projects match your search.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#111111] py-20 px-6 lg:px-10">
    <div class="max-w-4xl mx-auto text-center" data-animate>
      <h2 class="text-4xl lg:text-5xl font-black text-white mb-6">Have a Project in Mind?</h2>
      <p class="text-white/70 text-lg mb-10">
        We'd love to discuss how Reynolds Dryline can help deliver your next project to the highest standards.
      </p>
      <a href="/contact" class="rd-btn-primary">
        Get in Touch
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <Footer />
</ReynoldsLayout>

<script>
  const filterBtns = document.querySelectorAll('.rd-filter-btn');
  const statusBtns = document.querySelectorAll('.rd-status-btn');
  const sectorSelect = document.getElementById('rd-sector-select');
  const statusSelect = document.getElementById('rd-status-select');
  const projectItems = document.querySelectorAll('.rd-project-item');
  const searchRoot = document.getElementById('rd-project-search');
  const searchToggle = document.getElementById('rd-project-search-toggle');
  const searchPanel = document.getElementById('rd-project-search-panel');
  const searchInput = document.getElementById('rd-project-search-input');
  const searchInputMobile = document.getElementById('rd-project-search-input-mobile');
  const searchClose = document.getElementById('rd-project-search-close');
  const emptyState = document.getElementById('rd-projects-empty');
  const liveToggle = document.getElementById('rd-live-sites-toggle');
  const livePanel = document.getElementById('rd-live-sites-panel');
  const liveChevron = document.getElementById('rd-live-sites-chevron');

  let activeSector = 'All';
  let activeStatus = 'All';
  let searchQuery = '';

  function setActiveButton(
    buttons: NodeListOf<Element>,
    activeBtn: Element,
    activeClasses: string[],
    inactiveClasses: string[],
  ) {
    buttons.forEach((b) => {
      b.classList.remove(...activeClasses);
      b.classList.add(...inactiveClasses);
    });
    activeBtn.classList.add(...activeClasses);
    activeBtn.classList.remove(...inactiveClasses);
  }

  function syncSectorButtons() {
    filterBtns.forEach((btn) => {
      if (btn.getAttribute('data-sector') === activeSector) {
        setActiveButton(
          filterBtns,
          btn,
          ['bg-red-600', 'text-white', 'border-red-600'],
          ['bg-white', 'text-gray-600', 'border-gray-300', 'hover:border-red-600', 'hover:text-red-600'],
        );
      }
    });
    if (sectorSelect instanceof HTMLSelectElement) sectorSelect.value = activeSector;
  }

  function syncStatusButtons() {
    statusBtns.forEach((btn) => {
      if (btn.getAttribute('data-status') === activeStatus) {
        setActiveButton(
          statusBtns,
          btn,
          ['bg-slate-800', 'text-white', 'border-slate-800'],
          ['bg-white', 'text-gray-600', 'border-gray-300', 'hover:border-slate-800', 'hover:text-slate-800'],
        );
      }
    });
    if (statusSelect instanceof HTMLSelectElement) statusSelect.value = activeStatus;
  }

  function applyFilters() {
    let visibleCount = 0;

    projectItems.forEach((item) => {
      const el = item as HTMLElement;
      const itemSector = el.getAttribute('data-sector') || '';
      const itemStatus = el.getAttribute('data-status') || '';
      const haystack = el.getAttribute('data-search') || '';
      const matchesSector = activeSector === 'All' || itemSector === activeSector;
      const matchesStatus = activeStatus === 'All' || itemStatus === activeStatus;
      const matchesSearch = !searchQuery || haystack.includes(searchQuery);
      const isVisible = matchesSector && matchesStatus && matchesSearch;
      el.style.display = isVisible ? '' : 'none';
      if (isVisible) visibleCount += 1;
    });

    if (emptyState) {
      const showEmpty = visibleCount === 0;
      emptyState.hidden = !showEmpty;
      emptyState.classList.toggle('hidden', !showEmpty);
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeSector = btn.getAttribute('data-sector') || 'All';
      syncSectorButtons();
      applyFilters();
    });
  });

  statusBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeStatus = btn.getAttribute('data-status') || 'All';
      syncStatusButtons();
      applyFilters();
    });
  });

  sectorSelect?.addEventListener('change', () => {
    if (!(sectorSelect instanceof HTMLSelectElement)) return;
    activeSector = sectorSelect.value || 'All';
    syncSectorButtons();
    applyFilters();
  });

  statusSelect?.addEventListener('change', () => {
    if (!(statusSelect instanceof HTMLSelectElement)) return;
    activeStatus = statusSelect.value || 'All';
    syncStatusButtons();
    applyFilters();
  });

  function openSearch() {
    if (!searchRoot || !searchToggle || !searchPanel || !searchInput) return;
    searchRoot.classList.add('is-open');
    searchToggle.setAttribute('aria-expanded', 'true');
    searchToggle.classList.add('opacity-0', 'pointer-events-none');
    searchPanel.classList.remove('opacity-0', 'pointer-events-none');
    window.setTimeout(() => searchInput.focus(), 180);
  }

  function closeSearch() {
    if (!searchRoot || !searchToggle || !searchPanel || !searchInput) return;
    searchRoot.classList.remove('is-open');
    searchToggle.setAttribute('aria-expanded', 'false');
    searchToggle.classList.remove('opacity-0', 'pointer-events-none');
    searchPanel.classList.add('opacity-0', 'pointer-events-none');
    searchInput.value = '';
    if (searchInputMobile instanceof HTMLInputElement) searchInputMobile.value = '';
    searchQuery = '';
    applyFilters();
  }

  function onSearchInput(value: string) {
    searchQuery = value.trim().toLowerCase();
    if (searchInput instanceof HTMLInputElement && searchInput !== document.activeElement) {
      searchInput.value = value;
    }
    if (searchInputMobile instanceof HTMLInputElement && searchInputMobile !== document.activeElement) {
      searchInputMobile.value = value;
    }
    applyFilters();
  }

  searchToggle?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchInput?.addEventListener('input', () => {
    onSearchInput((searchInput as HTMLInputElement).value);
  });

  searchInputMobile?.addEventListener('input', () => {
    onSearchInput((searchInputMobile as HTMLInputElement).value);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchRoot?.classList.contains('is-open')) {
      closeSearch();
    }
  });

  liveToggle?.addEventListener('click', () => {
    if (!(livePanel instanceof HTMLElement) || !(liveToggle instanceof HTMLButtonElement)) return;
    const willOpen = livePanel.hidden;
    livePanel.hidden = !willOpen;
    liveToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    liveChevron?.classList.toggle('rotate-180', willOpen);
    if (willOpen) {
      const initMap = (window as Window & { __rdInitLiveSitesMap?: () => void }).__rdInitLiveSitesMap;
      if (typeof initMap === 'function') initMap();
    }
  });
</script>

<script id="rd-live-sites-data" type="application/json" set:html={JSON.stringify(liveSites)} />

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script>
  import L from 'leaflet';

  delete (L.Icon.Default.prototype as any)._getIconUrl;
  L.Icon.Default.mergeOptions({
    iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
    iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
    shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
  });

  type LiveSite = { title: string; location: string; lat: number; lng: number };

  let liveMap: L.Map | null = null;

  function readLiveSites(): LiveSite[] {
    const dataEl = document.getElementById('rd-live-sites-data');
    if (!dataEl?.textContent) return [];
    try {
      const parsed = JSON.parse(dataEl.textContent);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function initLiveSitesMap() {
    const mapEl = document.getElementById('rd-live-sites-map');
    const liveSites = readLiveSites();
    if (!mapEl || liveSites.length === 0) return;

    if (liveMap) {
      window.setTimeout(() => liveMap?.invalidateSize(), 50);
      window.setTimeout(() => liveMap?.invalidateSize(), 250);
      return;
    }

    liveMap = L.map(mapEl, {
      center: [52.6, -1.3],
      zoom: 7,
      scrollWheelZoom: false,
      zoomControl: true,
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(liveMap);

    const pulseIcon = L.divIcon({
      className: 'rd-live-marker',
      html: '<span class="rd-live-pulse"></span>',
      iconSize: [18, 18],
      iconAnchor: [9, 9],
    });

    const bounds: L.LatLngExpression[] = [];
    liveSites.forEach((site) => {
      bounds.push([site.lat, site.lng]);
      L.marker([site.lat, site.lng], { icon: pulseIcon })
        .addTo(liveMap!)
        .bindPopup(`<strong>${site.title}</strong><br/><span style="color:#6b7280">${site.location}</span>`);
    });

    if (bounds.length > 1) {
      liveMap.fitBounds(bounds as L.LatLngBoundsExpression, { padding: [40, 40], maxZoom: 9 });
    } else if (bounds.length === 1) {
      liveMap.setView(bounds[0], 9);
    }

    window.setTimeout(() => liveMap?.invalidateSize(), 50);
    window.setTimeout(() => liveMap?.invalidateSize(), 250);
  }

  (window as Window & { __rdInitLiveSitesMap?: () => void }).__rdInitLiveSitesMap = initLiveSitesMap;
</script>

