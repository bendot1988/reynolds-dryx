  .rd-live-sites-panel[hidden] {
    display: none;
  }

  :global(.rd-live-marker) {
    background: transparent;
    border: 0;
  }

  :global(.rd-live-pulse) {
    display: block;
    width: 14px;
    height: 14px;
    margin: 2px;
    border-radius: 999px;
    background: #e23125;
    border: 2px solid #fff;
    box-shadow: 0 0 0 0 rgba(226, 49, 37, 0.55);
    animation: rd-live-pulse 1.8s ease-out infinite;
  }

  @keyframes rd-live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(226, 49, 37, 0.55);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(226, 49, 37, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(226, 49, 37, 0);
    }
  }
</style>
