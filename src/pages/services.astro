---
import ReynoldsLayout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const services = [
  {
    slug: 'metal-stud-partitioning',
    title: 'Metal Stud Partitioning',
    desc: 'Our metal stud partitioning systems provide flexible, high-performance internal wall solutions for commercial, residential, and industrial projects. We deliver systems that meet the most demanding acoustic, fire, and structural requirements.',
    features: [
      'Single and double layer boarding',
      'Acoustic performance up to Rw 65dB',
      'Fire resistance up to 4 hours',
      'Structural and non-structural systems',
      'Curved and feature partitions',
    ],
    image: '/assets/reynolds/services/metal-stud-partitioning.png',
  },
  {
    slug: 'suspended-ceilings',
    title: 'Suspended Ceilings',
    desc: 'From standard grid and tile systems to bespoke feature ceilings, our suspended ceiling installations combine technical precision with aesthetic excellence. We work with all major manufacturers to deliver the right solution for your project.',
    features: [
      'Standard grid and tile systems',
      'Plasterboard and MF ceilings',
      'Feature and bespoke ceiling designs',
      'Acoustic and fire-rated systems',
      'Bulkheads and soffits',
    ],
    image: '/assets/reynolds/services/suspended-ceilings.png',
  },
  {
    slug: 'structural-framing-systems',
    title: 'Structural Framing Systems (SFS)',
    desc: 'Our structural framing system expertise enables us to deliver complex external wall solutions for multi-storey buildings. SFS provides the structural backbone for external cladding and facade systems.',
    features: [
      'Light gauge steel framing',
      'External wall infill systems',
      'Spandrel panel systems',
      'Rainscreen support systems',
      'Complex geometry and curved facades',
    ],
    image: '/assets/reynolds/services/sfs-service.png',
  },
  {
    slug: 'insulation-sound-proofing',
    title: 'Insulation & Sound Proofing',
    desc: 'We install a comprehensive range of insulation products to meet thermal, acoustic, and fire performance requirements. Our expertise ensures that the right insulation solution is specified and installed correctly.',
    features: [
      'Mineral wool and rigid board insulation',
      'Acoustic floor and wall systems',
      'Thermal performance solutions',
      'Fire barrier installations',
    ],
    image: '/assets/reynolds/services/insulation-soundproofing.png',
  },
  {
    slug: 'professional-plastering',
    title: 'Professional Plastering',
    desc: 'Our skilled plasterers deliver flawless finishes across all project types. From standard skim coats to specialist decorative plasterwork, we have the expertise to achieve the quality your project demands.',
    features: [
      'Wet plaster and skim coat finishes',
      'Dry lining and plasterboard',
      'Specialist and decorative plasterwork',
      'Render systems',
      'Remedial and repair works',
    ],
    image: '/assets/reynolds/services/professional-plastering.png',
  },
  {
    slug: 'fire-stopping',
    title: 'Fire Stopping',
    desc: 'Compliant passive fire protection for walls, floors and ceilings, installed with tested systems across residential, commercial and industrial projects.',
    features: [
      'Penetration seals for pipes, cables and ducts',
      'Linear gap and joint seals',
      'Cavity barriers within walls and voids',
      'Intumescent collars, wraps and sealants',
      'Installation to manufacturer tested details',
    ],
    image: '/assets/reynolds/services/fire-stopping.png',
  },
];
---

<ReynoldsLayout
  title="Our Services | Reynolds Dryline — Specialist Building Finishes"
  description="Reynolds Dryline provides metal stud partitioning, suspended ceilings, structural framing systems, insulation, plastering and fire stopping across the UK."
  canonical="https://www.reynoldsdryline.co.uk/services"
>
  <Header currentPath="/services" />

  <PageHero
    title="Our Services"
    subtitle="Complete building finishes solutions. From metal stud partitioning and fire stopping to professional plastering, we deliver every element of the internal envelope."
    breadcrumb="What We Do"
  />

  <!-- Services list -->
  <section class="rd-section rd-section--surface px-6 lg:px-10">
    <div class="max-w-7xl mx-auto space-y-10 lg:space-y-12">
      {services.map((service, i) => (
        <div
          id={service.slug}
          class={`rd-panel p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2 lg:[&>*:last-child]:order-1' : ''}`}
          data-animate
        >
          <!-- Image -->
          <div class="relative h-full min-h-[28rem] lg:min-h-[36rem] overflow-hidden rounded-[15px] border border-gray-200">
            <img
              src={service.image}
              alt={service.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out hover:scale-[1.03]"
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center items-start">
            <p class="rd-label mb-3">Our Services</p>
            <h2 class="text-4xl lg:text-5xl font-black text-gray-900 mb-3">{service.title}</h2>
            <div class="w-10 h-1 bg-red-600 mb-5"></div>
            <div class="space-y-4 mb-7">
              {(Array.isArray(service.desc) ? service.desc : [service.desc]).map((paragraph) => (
                <p class="text-gray-600 leading-relaxed">{paragraph}</p>
              ))}
            </div>

            <ul class="space-y-2.5 mb-8">
              {service.features.map(feature => (
                <li class="flex items-center gap-3 text-sm text-gray-700">
                  <svg class="w-5 h-5 text-red-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>

            <a href="/contact" class="rd-btn-primary !bg-[#111111] hover:!bg-black" style="--rd-btn-accent-bar: var(--rd-red);">
              Enquire About This Service
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</ReynoldsLayout>
